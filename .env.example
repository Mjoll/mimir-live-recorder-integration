# Settings for the live recorder example. Copy this file to .env and fill in the empty values.
# .env holds credentials, so keep it out of version control; .gitignore already excludes it.

# Mimir host, without a path.
MIMIR_BASE_URL=https://mimir.mjoll.no
# API key of the Mimir user the recorder acts as. It needs permission to create items.
MIMIR_API_KEY=
# ID of the Generated Media Location the proxy goes to. Register it with autoCreateItems: false.
GENERATED_MEDIA_LOCATION_ID=

# The S3 bucket and path prefix of that Generated Media Location.
# The prefix must be the location's path prefix exactly, including the trailing slash.
S3_BUCKET=
S3_PATH_PREFIX=recorder/

# AWS credentials that may call s3:PutObject under the path prefix and s3:HeadBucket on the bucket.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials.
AWS_SESSION_TOKEN=

# The Kelda live folder the growing high-res file is written to, as seen from this machine.
# Its "Externally generated web proxy and thumbnails" setting must be on.
LIVE_FOLDER_DIR=kelda/kelda-root/livefolders/recorder

# How long to record, in seconds.
RECORDING_SECONDS=60
